VITE_SSD_API_BASE_URL=http://localhost:8100
VITE_SSD_APP_ENV=local

# Dev deployment:
# Leave VITE_SSD_API_BASE_URL unset (or set it to /api) to use a same-origin proxy.
# The Vercel proxy target is configured in vercel.json.
# If overriding from Windows Git Bash, avoid raw /api because MSYS can convert it to a local path.
